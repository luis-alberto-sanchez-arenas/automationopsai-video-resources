NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://YOUR_RAILWAY_DOMAIN
DATABASE_URL=postgresql://...
PGSSLMODE=require
PGPOOL_MAX=8
MAX_BLOB_BYTES=367001600
STORAGE_SIGNING_SECRET=replace-with-long-random-secret

OWNER_USER_ID=owner
ADMIN_TOKEN=replace-with-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preferred low-cost/free-tier option:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: any OpenAI-compatible provider
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

KOKORO_TTS_URL=
KOKORO_TTS_TOKEN=
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_SPEED=0.97
KOKORO_TTS_TIMEOUT_MS=120000
