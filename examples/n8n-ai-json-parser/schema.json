{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leadId",
    "email",
    "intent",
    "confidence",
    "crmAction"
  ],
  "properties": {
    "leadId": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "intent": {
      "type": "string",
      "enum": [
        "sales",
        "support",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "crmAction": {
      "type": "string",
      "enum": [
        "create",
        "review",
        "reject"
      ]
    }
  }
}
